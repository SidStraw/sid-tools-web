{
  "openapi": "3.0.3",
  "info": {
    "title": "Sid Tools synthetic scenario contract",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://never-call.example.invalid"
    }
  ],
  "paths": {
    "/pets/{id}": {
      "get": {
        "responses": {
          "200": {
            "description": "Two fixed examples",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "first": {
                    "value": {
                      "id": 1,
                      "name": "Mochi"
                    }
                  },
                  "second": {
                    "value": {
                      "id": 2,
                      "name": "<img src=x onerror=alert(1)>"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "try-again"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "responses": {
          "201": {
            "description": "Seeded fixture",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "count"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 8
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
